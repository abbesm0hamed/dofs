[
  // Argument arrays only; no shell interpolation. Keep destructive actions out.
  { "id": "terminal", "name": "New terminal", "description": "Open Ghostty", "icon": "utilities-terminal", "keywords": "shell console", "command": ["ghostty"] },
  { "id": "files", "name": "Open home folder", "description": "Files", "icon": "system-file-manager", "keywords": "nautilus directory", "command": ["xdg-open", "~"] },
  { "id": "audio", "name": "Sound settings", "description": "Volume and audio devices", "icon": "audio-volume-high", "keywords": "speaker microphone pavucontrol", "command": ["pavucontrol"] },
  { "id": "network", "name": "Network settings", "description": "Edit network connections", "icon": "preferences-system-network", "keywords": "wifi ethernet internet", "command": ["nm-connection-editor"] },
  { "id": "bluetooth", "name": "Bluetooth settings", "description": "Manage Bluetooth devices", "icon": "preferences-system-bluetooth", "keywords": "headphones pairing", "command": ["blueman-manager"] },
  { "id": "mute", "name": "Toggle speaker mute", "description": "Default audio output", "icon": "audio-volume-muted", "keywords": "sound volume", "command": ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"] },
  { "id": "mic", "name": "Toggle microphone mute", "description": "Default audio input", "icon": "microphone-sensitivity-muted", "keywords": "privacy recording", "command": ["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle"] },
  { "id": "lock", "name": "Lock screen", "description": "Lock this session", "icon": "system-lock-screen", "keywords": "privacy quickshell", "command": ["bash", "~/.config/quickshell/dofs/scripts/lock-screen.sh"] },
  { "id": "github", "name": "Open GitHub", "description": "github.com", "icon": "web-browser", "keywords": "code repositories quicklink", "command": ["xdg-open", "https://github.com"] },

  // Menus: "menu" runs a provider script that prints one JSON item per line.
  // Each id is reachable from keybinds and the bar via: quickshell-launcher.sh <id>
  { "id": "power", "name": "Power menu", "description": "Lock, logout, suspend, reboot, shutdown", "icon": "system-shutdown", "keywords": "power off reboot suspend log out", "menu": ["~/.config/quickshell/dofs/scripts/power-menu.sh"] },
  { "id": "controls", "name": "System controls", "description": "Idle, night light, notifications, radios", "icon": "applications-system", "keywords": "toggles system", "menu": ["~/.config/niri/scripts/system-controls.sh"] },
  { "id": "settings", "name": "Settings menu", "description": "Audio, display, network, system info", "icon": "preferences-system", "keywords": "configure preferences", "menu": ["~/.config/niri/scripts/settings-menu.sh"] },
  { "id": "themes", "name": "Theme picker", "description": "Switch the session theme", "icon": "preferences-desktop-display", "keywords": "colors theme switch", "menu": ["~/.config/niri/scripts/theme-picker.sh"] },
  { "id": "wallpapers", "name": "Wallpaper picker", "description": "Apply a background image", "icon": "preferences-desktop-wallpaper", "keywords": "background image", "menu": ["~/.config/niri/scripts/wallpaper-picker.sh"] },
  { "id": "clipboard", "name": "Clipboard history", "description": "Restore a copied item", "icon": "edit-paste", "keywords": "clipboard paste", "menu": ["~/.config/niri/scripts/clipboard-manager.sh"] },
  { "id": "projects", "name": "Project launcher", "description": "Open a project in a new workspace", "icon": "folder-documents", "keywords": "code workspace dev", "menu": ["~/.config/niri/scripts/project-launcher.sh"] },
  { "id": "binds", "name": "Keybind cheat sheet", "description": "Copy any niri keybind", "icon": "preferences-desktop-keyboard", "keywords": "shortcuts keys help", "menu": ["~/.config/niri/scripts/binds-menu.sh"] },
  { "id": "notifications", "name": "Notification center", "description": "History, messages and do not disturb", "icon": "preferences-system-notifications", "keywords": "alerts history messages", "command": ["qs", "-c", "dofs", "ipc", "call", "notifications", "open"] },
  { "id": "bar", "name": "Configure status bar", "description": "Edit Quickshell modules, outputs and size (live reload)", "icon": "preferences-desktop-panels", "keywords": "bar status panel quickshell", "command": ["ghostty", "-e", "nvim", "~/.config/quickshell/dofs/bar/config.json"] }
]
