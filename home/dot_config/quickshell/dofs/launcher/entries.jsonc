[
  // Argument arrays only; no shell interpolation. Keep destructive actions out.
  { "id": "terminal", "name": "New terminal", "description": "Open Ghostty", "icon": "utilities-terminal", "keywords": "shell console", "command": ["ghostty"] },
  { "id": "files", "name": "Open home folder", "description": "Files", "icon": "system-file-manager", "keywords": "nautilus directory", "command": ["xdg-open", "~"] },
  { "id": "audio", "name": "Sound settings", "description": "Volume and audio devices", "icon": "audio-volume-high", "keywords": "speaker microphone pavucontrol", "command": ["pavucontrol"] },
  { "id": "network", "name": "Network settings", "description": "Edit network connections", "icon": "preferences-system-network", "keywords": "wifi ethernet internet", "command": ["nm-connection-editor"] },
  { "id": "bluetooth", "name": "Bluetooth settings", "description": "Manage Bluetooth devices", "icon": "preferences-system-bluetooth", "keywords": "headphones pairing", "command": ["blueman-manager"] },
  { "id": "mute", "name": "Toggle speaker mute", "description": "Default audio output", "icon": "audio-volume-muted", "keywords": "sound volume", "command": ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"] },
  { "id": "mic", "name": "Toggle microphone mute", "description": "Default audio input", "icon": "microphone-sensitivity-muted", "keywords": "privacy recording", "command": ["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle"] },
  { "id": "lock", "name": "Lock screen", "description": "Lock this session", "icon": "system-lock-screen", "keywords": "privacy hyprlock", "command": ["hyprlock"] },
  { "id": "github", "name": "Open GitHub", "description": "github.com", "icon": "web-browser", "keywords": "code repositories quicklink", "command": ["xdg-open", "https://github.com"] }
]
